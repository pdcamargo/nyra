{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nyra",
  "version": "0.3.4",
  "identifier": "com.nyra.app",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:install && npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Nyra",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1a1a1a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:* ws://127.0.0.1:* http://127.0.0.1:*",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Patrick Dias",
    "category": "DeveloperTool",
    "shortDescription": "A better Claude Code client",
    "longDescription": "Nyra is a desktop client for Claude Code, with sessions, workflows, an integrated terminal, and background process tracking.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.3",
      "signingIdentity": null
    },
    "resources": {
      "../sidecar": "sidecar"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pdcamargo/nyra/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1RTRCOTUwQkJCRjcwMDUKUldRRmNMKzdVTG5reFozSkVTWjJGa3FyWHdwSFcxWmhLR0lIdHpySDZxUkRKN1JCZlA3QWpHQXMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
